<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Paths with a file extension stay 404s, as for the service worker, so a missing chunk never gets index.html.
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # A cached copy of any of these would keep serving the old version.
  <FilesMatch "^(index\.html|ngsw\.json|ngsw-worker\.js|safety-worker\.js|worker-basic\.min\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build output (main-EKE6CUS4.js, chunk-D2O_9mdV.js, everything under media/) never
  # changes under its name, so browsers may keep it for a year. Files from public/ aren't hashed.
  <FilesMatch "^(main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/media/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
