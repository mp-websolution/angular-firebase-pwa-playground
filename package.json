{
  "name": "pwa-base",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run rules:assemble && firebase emulators:exec --ui \"npm run seed && ng serve\"",
    "build": "ng build",
    "test": "ng test",
    "test:sheriff": "vitest run sheriff-tests",
    "test:scripts": "vitest run script-tests",
    "test:integration": "npm run rules:assemble && firebase emulators:exec --only auth,firestore \"ng test --configuration=integration --watch=false\"",
    "seed": "node scripts/seed.mjs",
    "rules:assemble": "node scripts/assemble-rules.mjs",
    "baseline:update": "node scripts/update-baseline.mjs",
    "baseline:check-drift": "node scripts/check-baseline-drift.mjs",
    "icons": "node scripts/icons/generate.mjs",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run test:sheriff && npm run test:scripts && npm run lint && npm run format:check && npm test -- --watch=false && npm run build",
    "deps:graph": "sheriff export"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@softarc/eslint-plugin-sheriff": "0.20.0",
    "@softarc/sheriff-core": "0.20.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "15.34.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
