rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedInAsOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function isTrimmedTextOfLength(text, minLength, maxLength) {
      return text is string
        && text == text.trim()
        && text.size() >= minLength
        && text.size() <= maxLength;
    }

    match /profiles/{uid} {
      allow read, delete: if isSignedInAsOwner(uid);
      allow create, update: if isSignedInAsOwner(uid) && isValidProfile(request.resource.data);

      function isValidProfile(profile) {
        return profile.keys().hasOnly(['displayName'])
          && isValidDisplayName(profile.displayName);
      }

      function isValidDisplayName(displayName) {
        return isTrimmedTextOfLength(displayName, 2, 50);
      }
    }

    // Feature rules: inserted here by scripts/assemble-rules.mjs
  }
}
