rules_version = '2';

// Deny everything by default. Each collection opens access in its own match block.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Baseline: one profile per user, keyed by user ID. Only its owner can read or change it.
    match /profiles/{uid} {
      allow read, delete: if isSignedInAs(uid);
      allow create, update: if isSignedInAs(uid) && isValidProfile(request.resource.data);

      // A profile always has a display name: the profile page only offers an avatar upload once
      // one is saved.
      function isValidProfile(profile) {
        return profile.keys().hasOnly(['displayName', 'avatarUrl'])
          && isValidDisplayName(profile.displayName)
          && (!('avatarUrl' in profile) || profile.avatarUrl is string);
      }

      // The profile page saves display names trimmed, so 2 characters means 2 visible ones.
      function isValidDisplayName(displayName) {
        return displayName is string
          && displayName == displayName.trim()
          && displayName.size() >= 2
          && displayName.size() <= 50;
      }
    }

    // ---- Prototype: notes (src/app/notes) --------------------------------------------------
    // Delete this section together with the Prototype.

    // Each user's notes, under their user ID. Only their owner can read or change them.
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isSignedInAs(uid);
      allow create: if isSignedInAs(uid)
        && request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && isValidNoteText(request.resource.data.text)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedInAs(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && isValidNoteText(request.resource.data.text);

      // The notes page saves texts trimmed, so 1 character means 1 visible one.
      function isValidNoteText(text) {
        return text is string
          && text == text.trim()
          && text.size() >= 1
          && text.size() <= 1000;
      }
    }

    // ---- End of Prototype: notes -----------------------------------------------------------
  }
}
