rules_version = '2';

// Deny everything by default. Each collection opens access in its own match block.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Baseline: one profile per user, keyed by user ID. Only its owner can read or change it.
    match /profiles/{uid} {
      allow read, delete: if isSignedInAs(uid);
      allow create, update: if isSignedInAs(uid) && isValidProfile(request.resource.data);

      // Both fields are optional: a user may upload an avatar before choosing a display name.
      function isValidProfile(profile) {
        return profile.keys().hasOnly(['displayName', 'avatarUrl'])
          && (!('displayName' in profile) || isValidDisplayName(profile.displayName))
          && (!('avatarUrl' in profile) || profile.avatarUrl is string);
      }

      // The profile page saves display names trimmed, so 2 characters means 2 visible ones.
      function isValidDisplayName(displayName) {
        return displayName is string
          && displayName == displayName.trim()
          && displayName.size() >= 2
          && displayName.size() <= 50;
      }
    }
  }
}
