rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedInAsOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function isTrimmedTextOfLength(text, minLength, maxLength) {
      return text is string
        && text == text.trim()
        && text.size() >= minLength
        && text.size() <= maxLength;
    }

    match /profiles/{uid} {
      allow read, delete: if isSignedInAsOwner(uid);
      allow create, update: if isSignedInAsOwner(uid) && isValidProfile(request.resource.data);

      function isValidProfile(profile) {
        return profile.keys().hasOnly(['displayName', 'avatarUrl'])
          && isValidDisplayName(profile.displayName)
          && hasNoAvatarUrlOrATextOne(profile);
      }

      function isValidDisplayName(displayName) {
        return isTrimmedTextOfLength(displayName, 2, 50);
      }

      function hasNoAvatarUrlOrATextOne(profile) {
        return !('avatarUrl' in profile) || profile.avatarUrl is string;
      }
    }

    // ---- Prototype: notes (src/app/notes) --------------------------------------------------
    // Delete this section together with the Prototype.

    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isSignedInAsOwner(uid);
      allow create: if isSignedInAsOwner(uid) && isValidNewNote(request.resource.data);
      allow update: if isSignedInAsOwner(uid)
        && changesOnlyTheText(resource.data, request.resource.data)
        && isValidNoteText(request.resource.data.text);

      function isValidNewNote(note) {
        return note.keys().hasOnly(['text', 'createdAt'])
          && isValidNoteText(note.text)
          && isCreatedAtTheServerTime(note);
      }

      function isCreatedAtTheServerTime(note) {
        return note.createdAt == request.time;
      }

      function changesOnlyTheText(before, after) {
        return after.diff(before).affectedKeys().hasOnly(['text']);
      }

      function isValidNoteText(text) {
        return isTrimmedTextOfLength(text, 1, 1000);
      }
    }

    // ---- End of Prototype: notes -----------------------------------------------------------
  }
}
