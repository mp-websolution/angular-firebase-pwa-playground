match /notes/{noteId} {
  allow read: if true;
  allow create: if isSignedInAsAuthor(request.resource.data)
    && isValidNewNote(request.resource.data);
  allow update: if isSignedInAsAuthor(resource.data)
    && changesOnlyTheText(resource.data, request.resource.data)
    && isValidNoteText(request.resource.data.text);
  allow delete: if isSignedInAsAuthor(resource.data);

  function isSignedInAsAuthor(note) {
    return isSignedInAsOwner(note.authorUid);
  }

  function isValidNewNote(note) {
    return note.keys().hasOnly(['text', 'authorUid', 'createdAt'])
      && isValidNoteText(note.text)
      && isCreatedAtTheServerTime(note);
  }

  function isCreatedAtTheServerTime(note) {
    return note.createdAt == request.time;
  }

  function changesOnlyTheText(before, after) {
    return after.diff(before).affectedKeys().hasOnly(['text']);
  }

  function isValidNoteText(text) {
    return isTrimmedTextOfLength(text, 1, 1000);
  }
}
