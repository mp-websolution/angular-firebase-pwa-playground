rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedInAsOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    match /avatars/{uid} {
      allow read: if true;
      allow delete: if isSignedInAsOwner(uid);
      allow create, update: if isSignedInAsOwner(uid) && isAllowedAvatarImage(request.resource);

      // Same limits as the profile page. No SVG: it can carry scripts.
      function isAllowedAvatarImage(image) {
        return image.size <= 2 * 1024 * 1024
          && image.contentType.matches('image/(png|jpeg|webp|gif)');
      }
    }
  }
}
