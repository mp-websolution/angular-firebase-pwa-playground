rules_version = '2';

// Deny everything by default. Each storage path opens access in its own match block.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Baseline: one avatar per user, keyed by user ID. Anyone can see it, as anyone with its
    // download URL could anyway; only its owner can upload or delete it.
    match /avatars/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      // The profile page checks the same limits before uploading. No SVG: it can carry scripts,
      // which would run when someone opens the public URL directly.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
  }
}
